{
    "name": "simpaypl/laravel",
    "description": "Official SimPay.pl Laravel package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Patryk Vizauer",
            "email": "p.vizauer@simpay.pl"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SimPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimPay\\Laravel\\SimPayServiceProvider"
            ],
            "aliases": {
                "SimPay": "SimPay\\Laravel\\Facades\\SimPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
